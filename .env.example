# Supabase — get from Settings → API in Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=reservas@esenza.co

# Admin notifications — email that receives new booking alerts
ADMIN_NOTIFICATION_EMAIL=owner@esenza.co

# Cron secret — any random string, used to protect /api/cron/* endpoints
# Generate with: openssl rand -hex 32
CRON_SECRET=change_me_to_random_hex

# Public site URL (for email links and iCal UIDs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
